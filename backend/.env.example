# JWT secret for signing access tokens (min 32 chars)
JWT_SECRET=prospectusiq-super-secret-key-change-in-prod-2026

# Python ML engine base URL
# Local dev:
ML_ENGINE_URL=http://localhost:8001
# Render production: set automatically via render.yaml fromService reference

# Server port
PORT=3001

# Environment
NODE_ENV=development

# Database path (leave blank for local dev — defaults to ./sqlite.db)
# On Render: set to /data/sqlite.db (persistent disk mount)
DATABASE_URL=

# Internal service token — must match ml-engine .env
INTERNAL_SERVICE_TOKEN=prospectusiq-internal-service-token
