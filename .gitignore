# ==============================================================================
# ProspectusIQ .gitignore
# ==============================================================================

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
.env
.env.*
!.env.example
.Python

# --- Python Cache & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.so

# --- SEBI Raw PDF Files ---
data/sebi_official_raw/*.pdf
ml/data/sebi_official_raw/*.pdf

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Temp & Logs ---
*.log
*.tmp
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
node_modules/

# --- Database ---
# NOTE: sqlite.db IS committed so Render has an initial DB to copy to /data
# The WAL/SHM side-files are ephemeral — keep them ignored
*.db-wal
*.db-shm

# --- Frontend & Environment ---
.env.local

# --- Vector Database & Large ML Data ---
ml/data/chroma_db/
# ml/data/vector_db/   <-- INTENTIONALLY NOT IGNORED: sebi_faiss.index & metadata are required at runtime
ml/data/sebi_cleaned/
ml/data/*.pdf
data/*.pdf

